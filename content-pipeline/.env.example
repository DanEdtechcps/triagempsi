# Copie para .env (gitignored) e preencha. NUNCA commite o .env real.

# Conexão Postgres com a role de privilégio mínimo `psychoeducation_runner`
# (ver supabase/migrations/20260927020000_*.sql). NUNCA usar aqui a
# SUPABASE_SERVICE_ROLE_KEY do app — essa role só enxerga
# psychoeducation_generation_jobs, psychoeducation_generated_assets e
# psychoeducation_topics (leitura), nada de dado clínico de paciente.
#
# Usa o CONNECTION POOLER (Supavisor), não o host direto `db.*.supabase.co`
# — o host direto só resolve em IPv6, e a maioria das redes domésticas/ISP
# não tem saída IPv6 (foi exatamente o erro visto ao testar: "Connection
# timed out"). O pooler é IPv4 e exige o usuário no formato
# `<role>.<project_ref>` (não é a role sozinha, ver ENOIDENTIFIER se
# esquecer o sufixo).
DATABASE_URL=postgresql://psychoeducation_runner.ffyjjkouscnabyxjxexu:SENHA_AQUI@aws-0-us-west-2.pooler.supabase.com:5432/postgres

# Endpoint interno do app + token compartilhado (secret do Cloudflare Worker,
# `wrangler secret put PSYCHOEDUCATION_RUNNER_TOKEN`) — só serve pra subir
# mídia gerada e nada mais. Nunca é a chave de admin do Supabase.
APP_BASE_URL=https://triagempsi.pontocomumtus.workers.dev
RUNNER_TOKEN=TOKEN_AQUI

# Conta NotebookLM já usada pelo CENE (mesma assinatura Google AI Pro,
# mesma cota diária — este runner LÊ E ESCREVE no arquivo de cota do CENE
# pra nunca estourar o limite real de 20 gerações/dia da conta).
NOTEBOOKLM_ACCOUNT=coletivoaruatemvoz
